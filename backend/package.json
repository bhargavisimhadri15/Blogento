{
  "name": "blogapp-backend",
  "version": "1.0.0",
  "description": "Blog API with Express.js and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:lan": "set HOST=0.0.0.0&&set PORT=5000&&node server.js",
    "seed:admin": "node createuser.js",
    "cleanup:cover-images": "node cleanupCoverImages.js",
    "cleanup:cover-images:apply": "node cleanupCoverImages.js --apply",
    "reassign:orphan-posts": "node reassignOrphanPosts.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "serverless-http": "^3.2.0",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
